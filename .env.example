# Postgres connection string. When unset, the app uses an embedded PGlite
# database in ./var (perfect for local previews; not for production).
# DATABASE_URL=postgres://user:password@localhost:5432/larkspur

# PGLITE_DIR=./var/pglite

# Session signing secret. Generate with: openssl rand -hex 32
# AUTH_SECRET=

# Innkeeper sign-in (used by `npm run db:seed`)
# INNKEEPER_EMAIL=innkeeper@larkspurhouse.co.uk
# INNKEEPER_PASSWORD=larkspur
# INNKEEPER_NAME="Margaret Ellery"

# Hide the demo credentials hint on the sign-in page
# SHOW_DEMO_LOGIN=false

# ---- Object storage (optional) -------------------------------------------
# Room photos are stored on local disk by default. Point these at any
# S3-compatible bucket (AWS S3, Cloudflare R2, MinIO...) to use cloud storage.
# S3_BUCKET=larkspur-house
# S3_REGION=eu-west-2
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://s3.eu-west-2.amazonaws.com   # optional (R2/MinIO)
# S3_PUBLIC_BASE_URL=https://cdn.example.com       # optional CDN base URL
# S3_FORCE_PATH_STYLE=true                          # optional
